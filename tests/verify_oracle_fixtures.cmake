file(READ "${FIXTURES}/manifest.json" manifest)
string(JSON count LENGTH "${manifest}" files)
math(EXPR last "${count}-1")
foreach(i RANGE ${last})
    string(JSON name GET "${manifest}" files ${i} file)
    string(JSON expected GET "${manifest}" files ${i} sha256)
    string(JSON expected_size GET "${manifest}" files ${i} bytes)
    file(SIZE "${FIXTURES}/${name}" actual_size)
    file(SHA256 "${FIXTURES}/${name}" actual)
    if(NOT actual STREQUAL expected OR NOT actual_size EQUAL expected_size)
        message(FATAL_ERROR "Fixture SHA-256 mismatch: ${name}: ${actual} != ${expected}")
    endif()
endforeach()
file(READ "${FIXTURES}/../../../docs/validation/macos_standalone_2026-10-14.json" original)
foreach(i RANGE 0 2)
    string(JSON pattern GET "${original}" samples ${i} pattern)
    foreach(ext cfhd p10)
        if(ext STREQUAL cfhd)
            set(key sample_sha256)
        else()
            set(key decoded_sha256)
        endif()
        string(JSON expected GET "${original}" samples ${i} ${key})
        file(SHA256 "${FIXTURES}/${pattern}.${ext}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Fixture differs from PR #4 evidence: ${pattern}.${ext}")
        endif()
    endforeach()
endforeach()
if(DEFINED ENCODER)
    file(MAKE_DIRECTORY "${OUTPUT}")
    foreach(pattern flat gradient canonical)
        execute_process(COMMAND "${ENCODER}" ${pattern} "${OUTPUT}/${pattern}.cfhd" RESULT_VARIABLE result)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Standalone encode failed: ${pattern}")
        endif()
        file(SHA256 "${OUTPUT}/${pattern}.cfhd" actual)
        file(SHA256 "${FIXTURES}/${pattern}.cfhd" expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Packet changed: ${pattern}: ${actual} != ${expected}")
        endif()
    endforeach()
endif()
message(STATUS "Oracle fixture SHA-256 checks PASS (${count} files)")
