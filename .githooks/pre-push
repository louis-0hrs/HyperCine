#!/bin/sh
# Activate per worktree: git config --local core.hooksPath .githooks
# Scan every outgoing commit. Do not exclude other remotes: they can be private.
set -eu
cd "$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
else
  echo "Privacy guard: Python 3 unavailable; push blocked." >&2
  exit 2
fi
remote_name=${1:-}
# A URL-only push cannot be safely compared against an unrelated named remote.
# Reject it rather than silently miss commits present on a private remote.
if [ -z "$remote_name" ] || ! git remote | grep -Fqx -- "$remote_name"; then
  echo "Privacy guard: push via a configured remote name, not a raw URL." >&2
  exit 2
fi
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha
do
  [ "$local_sha" != "$zero" ] || continue
  if [ "$remote_sha" = "$zero" ]; then
    # A new remote branch: exclude only commits already published to THIS
    # destination. '--remotes' with no filter can hide private-remote commits.
    commits=$(git rev-list --reverse "$local_sha" --not "--remotes=$remote_name")
  else
    commits=$(git rev-list --reverse "$remote_sha..$local_sha")
  fi
  for sha in $commits
  do
    "$PYTHON" ci/privacy_guard.py --commit "$sha" || exit $?
  done
done
