#!/bin/sh
# Activate once per worktree: git config --local core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1; then
  python3 ci/privacy_guard.py --staged
elif command -v python >/dev/null 2>&1; then
  python ci/privacy_guard.py --staged
else
  echo "Privacy guard: Python 3 unavailable; commit blocked." >&2
  exit 2
fi
